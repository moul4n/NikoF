# Squad: ignore runtime state (logs, inbox, sessions)
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream

# Local-only bootstrap outputs and repo-adjacent fallback roots
.local/
/.cache/
/cache/
/models/
/providers/

# Stability harness run artifacts
tests/stability/artifacts/current/*
!tests/stability/artifacts/current/.gitkeep
tests/stability/artifacts/reports/*
!tests/stability/artifacts/reports/.gitkeep
tests/stability/artifacts/tmp-*/
tests/stability/artifacts/display-signoff.png

# Machine-local env files
.env.local
.env.*.local

# Common local Python envs for bootstrap or backend work
backend/.venv/
.venv/
.venv-test/

# Python cache artifacts
__pycache__/
*.pyc
*.pyo

# Frontend install and build outputs
frontend/node_modules/
frontend/dist/
frontend/test-results/
.vite/

# Root tooling install for the Tauri desktop shell (@tauri-apps/cli, etc.)
/node_modules/

# Rust / Tauri build outputs
/src-tauri/target/
/src-tauri/gen/schemas/

# Oversized VRM (~118MB) exceeds GitHub's 100MB push limit. Excluded from git
# until migrated to Git LFS; re-add via LFS to restore it.
assets/characters/flare/model.vrm

# Machine-local scratch / temp working dirs
# NOTE: Unity dir ignores are anchored to the repo root with a leading "/" so
# they only match Unity's top-level cache — an unanchored "Library/" also
# matched assets/animations/library/ on case-insensitive (Windows) filesystems,
# silently excluding the shared VRMA library.
.tmp/
.tmp-unity-temp/
/Logs/
/Library/
/ProjectSettings/
/UserSettings/

# Raw animation sources are tracked for now; keep JSON/DSL outputs in git as the
# semantic staging path for provenance and later promotion work.

# pixiv/VRoid VRMA Motion Pack — license forbids redistributing the extractable
# motion data, so the pack and its imported clips are kept local-only (NOT
# committed). Credit: Animation credits to pixiv Inc.'s VRoid Project.
/assets/animations/raw/inbox/VRMA_MotionPack.zip
/assets/animations/raw/inbox/_vrma_pack_extract/
/assets/animations/library/shared/emote.showcase.once.vrma
/assets/animations/library/shared/emote.spin.once.vrma
/assets/animations/library/shared/emote.pose.once.vrma
/assets/animations/library/shared/greet.greeting.once.vrma
/assets/animations/library/shared/gesture.peace.once.vrma
