# Production build config (Vite loads this only for `vite build`, not `vite dev`).
#
# The dev server proxies same-origin `/api` to the backend, so dev builds leave
# this unset. Production bundles (e.g. the Tauri desktop shell) are loaded from a
# different origin (http://tauri.localhost) and must call the backend directly.
# The backend allows this origin via CORS (see backend/app/main.py).
#
# Local-only, non-secret. Override per build with the real backend origin if it
# is not the default loopback address.
VITE_BACKEND_API_BASE_URL=http://127.0.0.1:8000
