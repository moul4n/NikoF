{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "frontend tsc noEmit root",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"exec",
				"--",
				"tsc",
				"--noEmit"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			],
			"group": "build"
		},
		{
			"label": "frontend tsc noEmit cwd",
			"type": "shell",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-Command",
				"Set-Location 'frontend'; npm exec -- tsc --noEmit"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			],
			"group": "build"
		}
	]
}